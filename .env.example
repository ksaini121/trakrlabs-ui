# Copy to .env.local and adjust.

# FastAPI base URL. Leave empty in development: Vite proxies /auth, /project,
# /issue and /health to API_PROXY_TARGET, so the browser sees one origin and the
# session cookie just works. Set it for production builds, e.g.
# VITE_API_URL=https://api.trakrlabs.com
VITE_API_URL=

# true: run the whole app on the in-browser mock backend (demos, offline work).
# `npm run dev:mocks` turns this on through .env.mocks.
VITE_USE_MOCKS=false

# Where the dev proxy sends API calls (read by vite.config.ts, not the browser).
API_PROXY_TARGET=http://localhost:8000
